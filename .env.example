# Copy this file to .env and fill in the values for your environment.
# cp .env.example .env

# Application root path (use "/" if the app is served from the domain root).
APP_ROOT=/

# Google Analytics. Set GA=1 to enable, and provide the UA tracking ID.
GA=0
GAUA=UA-XXXXXXXX-X

# Base URL of the media/streaming service that serves thumbnails and the
# video embed/player (e.g. https://media.example.edu).
media_service=

# Base URL of the library discovery ("Bobcat") site, used for the
# "back to NYU Libraries" link.
bobcat_url=

# PNXS (Primo) search API endpoint used to look up item metadata by NOID.
pnxs_service=

# Primo permalink service base, used to build citation/permalink URLs.
primo_service=

# Prefix prepended to the NOID when querying PNXS (e.g. "hidvl" + noid).
pnxs_query_prefix=hidvl

# PNXS field searched for the prefixed NOID value (e.g. "lsr12").
pnxs_search_field=lsr12

# API key required to authenticate requests to the PNXS service.
apikey=
